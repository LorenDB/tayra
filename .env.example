# Copy to .env and edit before first deploy:
#   cp .env.example .env

# ── Public pod URL (required) ────────────────────────────────────────────
# Used by the API at runtime AND baked into the Tayra SPA when you
# `docker compose build front`. Changing the hostname later requires
# rebuilding the front image:
#   docker compose build --no-cache front && docker compose up -d front
FUNKWHALE_HOSTNAME=music.example.com
FUNKWHALE_PROTOCOL=https

# Host bind for the published front port
FUNKWHALE_API_IP=0.0.0.0
FUNKWHALE_API_PORT=5000

# ── Secrets (change these) ───────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.production

# ── Database / cache (match service names in docker-compose.yml) ────────
DATABASE_URL=postgresql://postgres@postgres:5432/postgres
CACHE_URL=redis://redis:6379/0

# ── In-container paths (Django) ──────────────────────────────────────────
MUSIC_DIRECTORY_PATH=/music
MEDIA_ROOT=/srv/funkwhale/data/media
STATIC_ROOT=/srv/funkwhale/data/static

# Host-side bind mounts (relative to the compose project directory)
MUSIC_DIRECTORY_SERVE_PATH=./data/music
# Optional overrides if you keep media/static elsewhere on the host:
# MEDIA_HOST_PATH=./data/media
# STATIC_HOST_PATH=./data/static

# ── Reverse proxy / nginx ────────────────────────────────────────────────
REVERSE_PROXY_TYPE=nginx
NGINX_MAX_BODY_SIZE=100M

# ── Workers ──────────────────────────────────────────────────────────────
FUNKWHALE_WEB_WORKERS=4
CELERYD_CONCURRENCY=0
LOGLEVEL=info

# ── Email (optional) ─────────────────────────────────────────────────────
# EMAIL_CONFIG=consolemail://
# DEFAULT_FROM_EMAIL=noreply@music.example.com

# ── OIDC SSO (optional) ──────────────────────────────────────────────────
# Enable single sign-on with an external OpenID Connect IdP.
# Register this redirect URI at the IdP:
#   {FUNKWHALE_PROTOCOL}://{FUNKWHALE_HOSTNAME}/api/v1/users/oidc/callback/
# Can also be configured in Instance settings (users__oidc_*).
# OIDC_ENABLED=false
# OIDC_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_DISPLAY_NAME=SSO
# OIDC_AUTO_CREATE=false
